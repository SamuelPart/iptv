<?xml version="1.0" encoding="utf-8"?>
<!-- Buscador de Inicio: solo peliculas y series (titulo, actor o director).
     Historial de busquedas con papelera + seccion "Busqueda popular" en fila.
     Anuncio en bloque arriba del boton Cancelar. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1834">

    <LinearLayout
        android:id="@+id/searchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_apple_glass_pill"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_ios_search"
                app:tint="#C9A96E"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/edtCineSearchInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Buscar película, serie, actor o director…"
                android:textColorHint="#6E6E78"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no" />

            <ImageView
                android:id="@+id/btnCineSearchClear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="8dp"
                android:src="@drawable/ic_ios_xmark"
                app:tint="#8A8A93"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Limpiar" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentSearch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/searchHeader"
        app:layout_constraintBottom_toTopOf="@id/adSlotSearch">

        <!-- Modo reposo: historial + popular -->
        <ScrollView
            android:id="@+id/scrollIdle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Búsquedas recientes"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="Limpiar"
                        android:textColor="#8A8A93"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtHistoryEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Aún no tienes búsquedas guardadas"
                    android:textColor="#6E6E78"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCineSearchHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/txtPopularTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp"
                    android:text="Búsqueda popular"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCinePopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="2dp"
                    android:paddingEnd="16dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"
                    android:overScrollMode="never" />
            </LinearLayout>
        </ScrollView>

        <!-- Resultados al escribir -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCineResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/txtResultsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Sin resultados para tu búsqueda"
            android:textColor="#8A8A93"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Anuncio en bloque (nativo) -->
    <FrameLayout
        android:id="@+id/adSlotSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnSearchCancel" />

    <TextView
        android:id="@+id/btnSearchCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_apple_glass_pill"
        android:gravity="center"
        android:paddingVertical="13dp"
        android:text="Cancelar"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
