<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:xbackground="@android:color/transparent"
    android:background="#0D0E11">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnCineSearchBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_chevron"
            app:tint="#C9A96E"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#F516181C"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_ios_search"
                    app:tint="#8A8A93" />

                <EditText
                    android:id="@+id/editCineQuery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Buscar película o serie..."
                    android:textColorHint="#5C5C64"
                    android:textColor="#F2F2F4"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <TextView
        android:id="@+id/txtCineSearchHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="90dp"
        android:paddingHorizontal="40dp"
        android:text="Escribe para buscar en películas y series"
        android:textColor="#606068"
        android:textSize="12.5sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCineSearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:clipToPadding="false"
        android:clipChildren="false" />
</LinearLayout>
