<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ios_gradient">

    <!-- Hero cinematografico 300dp -->
    <FrameLayout
        android:id="@+id/layoutBackdropHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="300dp">

        <ImageView
            android:id="@+id/imgMovieBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Backdrop" />

        <View
            android:id="@+id/viewBackdropFade"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_backdrop_fade" />

        <!-- Inline VLC Video Player Layout (Hidden by default) -->
        <FrameLayout
            android:id="@+id/layoutInlinePlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone">

            <org.videolan.libvlc.util.VLCVideoLayout
                android:id="@+id/inlineVlcVideoLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/imgDoubleTapLeft"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_ten_seconds_skip"
                android:rotation="180"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="30dp"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/imgDoubleTapRight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_ten_seconds_skip"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="30dp"
                app:tint="#FFFFFF" />

            <RelativeLayout
                android:id="@+id/layoutInlineControls"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#44000000">

                <ProgressBar
                    android:id="@+id/inlineProgress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerInParent="true"
                    android:indeterminateTint="@color/ios_cyan"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutInlineBottomBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:background="#DD0F121F"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/txtInlineCurrentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#88FFFFFF"
                            android:textSize="10sp" />

                        <SeekBar
                            android:id="@+id/inlineSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:progressTint="@color/ios_blue"
                            android:thumbTint="@color/ios_blue"
                            android:paddingHorizontal="4dp" />

                        <TextView
                            android:id="@+id/txtInlineTotalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#88FFFFFF"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btnInlinePlayPause"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_ios_pause"
                            app:tint="@color/ios_blue"
                            android:contentDescription="Reproducir/Pausar" />

                        <Button
                            android:id="@+id/btnInlineServers"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_button_secondary"
                            android:text="Servidores"
                            android:textColor="#FFFFFF"
                            android:textSize="8sp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="0dp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnInlineFullscreen"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="8dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_maximize_video"
                            app:tint="#FFFFFF"
                            android:contentDescription="Maximizar" />

                        <ImageButton
                            android:id="@+id/btnInlineClose"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_close_video"
                            android:contentDescription="Cerrar Video" />

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </FrameLayout>

    </FrameLayout>

    <!-- Boton volver: circulo de vidrio iPhone -->
    <ImageButton
        android:id="@+id/btnMovieBack"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_glass"
        android:padding="12dp"
        android:src="@drawable/ic_back_chevron"
        app:tint="#FFFFFF"
        android:elevation="10dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <View
                android:id="@+id/viewSpaceHeader"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <LinearLayout
                android:id="@+id/layoutMovieDetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ARCO DE VIDRIO: un solo panel que abraza todo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_vault_panel"
                    android:padding="20dp">

                    <!-- Fila superior: eyebrow + poster flotante arriba a la derecha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="PELÍCULA"
                                android:textColor="#C9A96E"
                                android:letterSpacing="0.22"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtMovieTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="TITLE"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:maxLines="3"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/txtMovieMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="2024 · Sci-Fi · 2h 46m"
                                android:textColor="#98989F"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:layout_width="112dp"
                            android:layout_height="168dp"
                            android:layout_marginTop="-46dp"
                            android:layout_marginStart="14dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="12dp"
                            app:cardBackgroundColor="@color/ios_surface_2">

                            <ImageView
                                android:id="@+id/imgMoviePoster"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="Poster" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- Modulo de rating -->
                    <TextView
                        android:id="@+id/txtMovieRatingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_chip_active"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="★ 8.5"
                        android:textColor="#16181C"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Acciones -->
                    <LinearLayout
                        android:id="@+id/layoutActionButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnMoviePlay"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_chip_active"
                            android:text="Ver ahora"
                            android:textAllCaps="false"
                            android:textColor="#16181C"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnMovieTrailer"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="46dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_button_secondary"
                                android:text="Trailer"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnMovieShare"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="46dp"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/bg_button_secondary"
                                android:text="Compartir"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Sinopsis: hairline + texto -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="22dp"
                        android:background="#14FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:text="SINOPSIS"
                        android:textColor="@color/ios_cyan"
                        android:letterSpacing="0.14"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMovieOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.35"
                        android:text="Cargando sinopsis de la película..."
                        android:textColor="#D9D9DF"
                        android:textSize="14sp" />

                    <!-- Reparto -->
                    <LinearLayout
                        android:id="@+id/layoutCastSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="REPARTO"
                            android:textColor="@color/ios_cyan"
                            android:letterSpacing="0.14"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- Servidores -->
                    <LinearLayout
                        android:id="@+id/layoutMovieServers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SERVIDORES"
                            android:textColor="@color/ios_cyan"
                            android:letterSpacing="0.14"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMovieServers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
