<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/txtCastTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transmitir a la TV 📺"
        android:textColor="#FF9800"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Selecciona tu dispositivo para reproducir de forma nativa"
        android:textColor="#888888"
        android:textSize="12sp" />

    <!-- Scanning status container -->
    <LinearLayout
        android:id="@+id/layoutCastScanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#FF9800" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Buscando televisores en tu red Wi-Fi..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Discovered Devices List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCastDevices"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false" />

    <!-- Close button -->
    <Button
        android:id="@+id/btnCancelCast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#333333"
        android:text="Cerrar"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>
