<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/ios_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <!-- Numero del sintonizador (champagne) -->
            <TextView
                android:id="@+id/txtChannelNumber"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="21"
                android:textColor="@color/ios_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Tile del logo -->
            <androidx.cardview.widget.CardView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginStart="14dp"
                app:cardBackgroundColor="@color/ios_surface_2"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Logo del canal"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />
            </androidx.cardview.widget.CardView>

            <!-- Nombre + meta -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtChannelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="DAZN 1"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewChannelLiveDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot_live" />

                    <TextView
                        android:id="@+id/txtChannelMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Deportes · Espana"
                        android:textColor="#7A7A7C"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Estrella favorito -->
            <ImageView
                android:id="@+id/imgChannelFav"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Favorito"
                android:padding="4dp"
                android:src="@drawable/ic_ios_star"
                android:visibility="gone"
                app:tint="#E6FFFFFF" />

            <!-- Play champagne -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="▶"
                android:textColor="@color/ios_blue"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Anillo de foco champagne (encendido por distancia al centro) -->
        <View
            android:id="@+id/viewChannelFocusRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ring_focus"
            android:visibility="gone" />

    </FrameLayout>
</androidx.cardview.widget.CardView>
