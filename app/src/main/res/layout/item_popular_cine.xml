<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de la fila "Busqueda popular": poster con etiquetas HOT/TOP,
     icono de play si esta en el catalogo, y titulo debajo. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="112dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="10dp">

    <androidx.cardview.widget.CardView
        android:layout_width="112dp"
        android:layout_height="158dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#14294F">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgPopularPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Poster" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="top|start"
                android:layout_margin="5dp">

                <TextView
                    android:id="@+id/txtPopularHot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_hot"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="HOT"
                    android:textColor="#FFFFFF"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtPopularTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_badge_top"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="TOP"
                    android:textColor="#0F2144"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgPopularPlay"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_glass"
                android:src="@drawable/ic_ios_play"
                app:tint="#C9A96E"
                android:padding="7dp"
                android:visibility="gone"
                android:contentDescription="Reproducir" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtPopularTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
