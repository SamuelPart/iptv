<?xml version="1.0" encoding="utf-8"?>
<!-- Popup iOS con el codigo QR para compartir -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_ios"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtQrTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Titulo"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgQrCode"
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Codigo QR"
        android:src="@drawable/ic_ios_qr" />

    <TextView
        android:id="@+id/txtQrLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="https://..."
        android:textAlignment="center"
        android:textColor="@color/ios_gray"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Escanealo con otro móvil para abrir este enlace al instante"
        android:textAlignment="center"
        android:textColor="@color/ios_cyan"
        android:textSize="10sp" />
</LinearLayout>
