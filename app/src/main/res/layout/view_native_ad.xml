<?xml version="1.0" encoding="utf-8"?>
<!-- Bloque de anuncio nativo AVANZADO (vertical, con vídeo/imagen) -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nativeAdViewRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fila superior: icono + titular + sello -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/global_ad_app_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Icono del anunciante"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/global_ad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/global_ad_attribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_active"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="ANUNCIO"
                android:textColor="#1B1E24"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vídeo / imagen del anuncio -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/global_ad_media"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            android:scaleType="fitCenter" />

        <!-- Texto del anuncio -->
        <TextView
            android:id="@+id/global_ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#98989F"
            android:textSize="12sp" />

        <!-- Botón de llamada a la acción -->
        <Button
            android:id="@+id/global_ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/ios_blue"
            android:minWidth="120dp"
            android:text="Instalar"
            android:textColor="#1B1E24"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
