<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta "Continuar viendo" del Home -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="272dp"
    android:layout_height="86dp"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ios_surface">

        <ImageView
            android:id="@+id/imgCwPoster"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Poster"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtCwTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Titulo"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnCwPlay"
            app:layout_constraintStart_toEndOf="@+id/imgCwPoster"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtCwSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Reanudar en 12:34"
            android:textColor="@color/ios_gray"
            android:textSize="10.5sp"
            app:layout_constraintEnd_toStartOf="@+id/btnCwPlay"
            app:layout_constraintStart_toStartOf="@+id/txtCwTitle"
            app:layout_constraintTop_toBottomOf="@+id/txtCwTitle" />

        <!-- Barra de progreso cyan -->
        <ProgressBar
            android:id="@+id/pbCwProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:max="100"
            android:progress="45"
            android:progressTint="@color/ios_cyan"
            android:progressBackgroundTint="#33FFFFFF"
            android:scaleY="1.4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnCwPlay"
            app:layout_constraintStart_toStartOf="@+id/txtCwTitle" />

        <!-- Pildora EN VIVO (live channels) -->
        <TextView
            android:id="@+id/txtCwLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="EN VIVO"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/pbCwProgress"
            app:layout_constraintStart_toStartOf="@+id/pbCwProgress"
            app:layout_constraintTop_toTopOf="@+id/pbCwProgress" />

        <ImageView
            android:id="@+id/btnCwPlay"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_aurora"
            android:contentDescription="Continuar"
            android:padding="11dp"
            android:src="@drawable/ic_ios_play"
            app:tint="#FFFFFF"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
