<?xml version="1.0" encoding="utf-8"?>
<!-- Seccion de Inicio en pantalla propia: misma interfaz del Inicio
     (buscador con lupa + cuadricula 3x3 con loading escalonado) pero
     mostrando SOLO el catalogo de la seccion elegida. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1834">

    <LinearLayout
        android:id="@+id/sectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnSectionBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:background="@drawable/bg_circle_glass"
            android:src="@drawable/ic_ios_xmark"
            app:tint="#FFFFFF"
            android:contentDescription="Cerrar" />

        <TextView
            android:id="@+id/txtSectionTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#C9A96E"
            android:letterSpacing="0.12"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Buscador como el de Inicio: lupa a la izquierda + X para limpiar -->
    <LinearLayout
        android:id="@+id/sectionSearchBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_apple_glass_pill"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/sectionHeader">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_ios_search"
            app:tint="#C9A96E"
            android:contentDescription="Buscar" />

        <EditText
            android:id="@+id/edtSectionSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Buscar en esta sección…"
            android:textColorHint="#6E6E78"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no" />

        <ImageView
            android:id="@+id/btnSectionClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:src="@drawable/ic_ios_xmark"
            app:tint="#8A8A93"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Limpiar" />
    </LinearLayout>

    <!-- Cuadricula 3x3 con paginacion (loading sin texto abajo) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSectionGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/sectionSearchBar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/txtSectionEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sin resultados en esta sección"
        android:textColor="#8A8A93"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/sectionSearchBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/pbSectionLoader"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginBottom="10dp"
        android:indeterminateTint="#C9A96E"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
