<?xml version="1.0" ?><androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:keepScreenOn="true">

    <!-- VLC Video Layout - VLC plays directly here! -->
    <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/vlcVideoLayout" android:layout_width="match_parent" android:layout_height="match_parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <!-- Night mode dimmer: oscurece el video pero NO los gestos -->
    <View android:id="@+id/viewNightDimmer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#E0000000" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <!-- Clickable overlay to toggle controller visibility -->
    <View android:id="@+id/viewTouchTarget" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent"/>

    <!-- Custom Player Controls Container -->
    

    <!-- Custom styled center Loading Buffering Indicator -->
    <ProgressBar android:id="@+id/playerProgress" android:layout_width="64dp" android:layout_height="64dp" android:indeterminateTint="@color/ios_cyan" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <!-- Source Selection Button (Bottom Right) -->
    

    <!-- ================= NATIVE CASTING CONTROLLER OVERLAY ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layoutCastController" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ios_surface" android:visibility="gone">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

            <ImageView android:layout_width="120dp" android:layout_height="120dp" android:src="@drawable/ic_cast" app:tint="@color/ios_blue"/>

            <TextView android:id="@+id/txtConnectedTv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Transmitiendo en Smart TV" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>

            <TextView android:id="@+id/txtCastPlayingTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Reproduciendo: Película" android:textColor="#888888" android:textSize="14sp"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center">

                <ImageButton android:id="@+id/btnCastPlayPause" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginEnd="16dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ios_pause" android:contentDescription="Reproducir/Pausar en TV" app:tint="@color/ios_blue"/>

                <Button android:id="@+id/btnCastDisconnect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#FF6E6E" android:text="Detener Transmisión" android:textColor="#FFFFFF" android:textStyle="bold" app:cornerRadius="24dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Left Double Tap Indicator Overlay -->
    <ImageView android:id="@+id/imgDoubleTapLeft" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_ten_seconds_skip" android:rotation="180" android:padding="16dp" android:visibility="gone" android:elevation="20dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/layoutCenterControls" app:layout_constraintTop_toTopOf="parent" app:tint="#FFFFFF"/>

    <!-- Gesture indicator: volumen / brillo al deslizar -->
    <TextView android:id="@+id/txtGestureIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="84dp" android:background="@drawable/bg_player_dock" android:elevation="30dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="🔊 60%" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" tools:visibility="visible" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <!-- Right Double Tap Indicator Overlay -->
    <ImageView android:id="@+id/imgDoubleTapRight" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_ten_seconds_skip" android:padding="16dp" android:visibility="gone" android:elevation="20dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/layoutCenterControls" app:layout_constraintTop_toTopOf="parent" app:tint="#FFFFFF"/>

</androidx.constraintlayout.widget.ConstraintLayout>