<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- VLC Video Layout - VLC plays directly here! -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlcVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Clickable overlay to toggle controller visibility -->
    <View
        android:id="@+id/viewTouchTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Custom Player Controls Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPlayerControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="visible"
        tools:visibility="visible">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/layoutPlayerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minimize_video"
                android:contentDescription="Atrás"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/txtPlayingName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Reproduciendo con VLC"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- PiP / Floating Window Button -->
            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pip"
                android:contentDescription="Miniatura / Pantalla Flotante"
                app:tint="@color/ios_blue" />

            <!-- Cast / Share to TV Button -->
            <ImageButton
                android:id="@+id/btnShareTv"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cast"
                android:contentDescription="Transmitir a TV"
                app:tint="@color/ios_blue" />
        </LinearLayout>

        <!-- Center Controls: Play, Rewind, Fast Forward -->
        <LinearLayout
            android:id="@+id/layoutCenterControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Rewind 10s Button -->
            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_rew"
                android:contentDescription="Retroceder 10s"
                app:tint="#FFFFFF" />

            <!-- Big Play/Pause Toggle -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:layout_marginHorizontal="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_pause"
                android:contentDescription="Reproducir/Pausar"
                app:tint="@color/ios_blue" />

            <!-- Fast Forward 10s Button -->
            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_ff"
                android:contentDescription="Adelantar 10s"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Bottom Timeline Seekbar & Duration counter -->
        <LinearLayout
            android:id="@+id/layoutBottomTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Current Elapsed Time -->
            <TextView
                android:id="@+id/txtCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Progress Seekbar -->
            <SeekBar
                android:id="@+id/vlcSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/ios_blue"
                android:thumbTint="@color/ios_blue" />

            <!-- Total Remaining Duration -->
            <TextView
                android:id="@+id/txtTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Custom styled center Loading Buffering Indicator -->
    <ProgressBar
        android:id="@+id/playerProgress"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@color/ios_blue"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Source Selection Button (Bottom Right) -->
    <ImageButton
        android:id="@+id/btnSelectSource"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_slideshow"
        android:contentDescription="Seleccionar Calidad/Servidor"
        android:visibility="gone"
        app:tint="@color/ios_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= NATIVE CASTING CONTROLLER OVERLAY ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCastController"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ios_bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_cast"
                app:tint="@color/ios_blue" />

            <TextView
                android:id="@+id/txtConnectedTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Transmitiendo en Smart TV"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCastPlayingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Reproduciendo: Película"
                android:textColor="#888888"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnCastPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="16dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_pause"
                    android:contentDescription="Reproducir/Pausar en TV"
                    app:tint="@color/ios_blue" />

                <Button
                    android:id="@+id/btnCastDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D32F2F"
                    android:text="Detener Transmisión"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Left Double Tap Indicator Overlay -->
    <ImageView
        android:id="@+id/imgDoubleTapLeft"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_ten_seconds_skip"
        android:rotation="180"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutCenterControls"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <!-- Right Double Tap Indicator Overlay -->
    <ImageView
        android:id="@+id/imgDoubleTapRight"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_ten_seconds_skip"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layoutCenterControls"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
