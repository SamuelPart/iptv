<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del historial de lo visto: POSTER a la izquierda; a la derecha el
     titulo y debajo "Te quedaste en el minuto X". Check para modo editar. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="10dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_row_glass"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="58dp"
            android:layout_height="82dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0F2144">

            <ImageView
                android:id="@+id/imgWatchPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Poster" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtWatchTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtWatchMinute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#C9A96E"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chkWatchSelect"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_glass"
            android:src="@drawable/ic_ios_xmark"
            app:tint="#C9A96E"
            android:padding="7dp"
            android:visibility="gone"
            android:contentDescription="Seleccionar" />
    </LinearLayout>
</FrameLayout>
