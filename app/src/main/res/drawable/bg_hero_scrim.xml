<?xml version="1.0" encoding="utf-8"?>
<!-- Degradados del HÉROE: oscurece la base y el borde izquierdo para que
     el título y los botones siempre se lean sobre cualquier póster. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F20B1220"
                android:centerColor="#660B1220"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#66000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
