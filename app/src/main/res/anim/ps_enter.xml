<?xml version="1.0" encoding="utf-8"?>
<!-- PS5-style open: the new screen zooms out from the card with an overshoot settle -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="true"
    android:interpolator="@android:anim/overshoot_interpolator"
    android:duration="320">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale
        android:fromXScale="0.86" android:toXScale="1"
        android:fromYScale="0.86" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <translate android:fromYDelta="6%" android:toYDelta="0%" />
</set>
