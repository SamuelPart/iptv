<?xml version="1.0" encoding="utf-8"?>
<!-- PlayStation-style close: fade + zoom-out sweep -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="true"
    android:interpolator="@android:anim/accelerate_interpolator"
    android:duration="240">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale
        android:fromXScale="1" android:toXScale="0.94"
        android:fromYScale="1" android:toYScale="0.94"
        android:pivotX="50%" android:pivotY="50%" />
    <translate android:fromYDelta="0%" android:toYDelta="4%" />
</set>
